# Server-only Postgres connection used by the admin settings API.
# Series reports use Supabase's API and do not need this connection string.
DATABASE_URL=

# Server-only Supabase key used by the series report API. Never prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY is also supported for projects using the legacy key.
SUPABASE_SECRET_KEY=

# Required for scheduled background sync and server-side bookmark updates.
# Set CRON_SECRET to a long random value; configure your cron caller to send
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Email allowed by the catalog RLS policies and manual background-sync API.
ADMIN_EMAIL=clydhex@gmail.com

# Optional dedicated HMAC key for hashing bookmark rate-limit IPs.
BOOKMARK_RATE_LIMIT_SECRET=
